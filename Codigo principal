#include <iostream>
#include <string>
#include <vector>
using namespace std;

struct Livro {
  int cod;
  string nome;
  string autor;
  int ano;
};

int main (){
vector<Livro> estante;
int esc;
while (esc != 0) {
cout << "OLÁ, Oque você gostaria de fazer hoje?\n";
cout << "1 - cadastrar livro\n";
cout << "2 - Remover livro\n";
cout << "3 - Trocar Livro de Posição\n";
cout << "0 - para encerar o programa\n";
cin >> esc;


switch (esc){
  case 1:
      Livro novo;

   cout << "Digite o código: ";
   cin >> novo.cod;
   cin.ignore();

    cout << "Digite o nome: ";
     getline(cin, novo.nome);

      cout << "Digite o autor: ";
      getline(cin, novo.autor);

     cout << "Digite o ano: ";
      cin >> novo.ano;

      estante.push_back(novo);
     cout << "Livro cadastrado na posição " << estante.size() << "!\n\n\n";
       break;
};
}
}




}
